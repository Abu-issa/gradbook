@model CreateMessageViewModel
@{ ViewData["Title"] = "Leave your words"; var reactions = new[] { ("🎓", "Graduation"), ("🏆", "Achievement"), ("⭐", "Star"), ("🌟", "Shining star"), ("💛", "Golden heart"), ("🎉", "Celebration"), ("👏", "Applause"), ("💪", "Strength"), ("🔥", "Amazing"), ("❤️", "Love") }; }
<section class="shell compose-layout">
    <aside class="compose-intro">
        <a class="back-link" asp-controller="Messages" asp-action="Index">← The message wall</a>
        <span class="eyebrow">YOUR WORDS, PART OF THE STORY</span>
        <h1>Make it<br />
            <em>personal.</em>
        </h1>
        <p>A favorite memory. A wish for the future.<br />Or simply, “you did it.”</p>
        <div class="compose-dedication">
            <img src="~/images/graduate.jpg" alt="Mohammed Abu-Issa" />
            <div>
                <span class="eyebrow">A NOTE FOR</span>
                <strong>Eng. Mohammed Abu-Issa</strong>
                <span>Class of 2026</span>
            </div>
        </div>
        <div class="compose-footnote">
            <span aria-hidden="true">🎓</span>
            <p>Every message is reviewed before it joins the wall. Thank you for making this chapter special.</p>
        </div>
    </aside>
    <div class="letter-form">
        <div class="letter-heading">
            <span class="eyebrow">A LITTLE NOTE. A LASTING MEMORY.</span>
            <span aria-hidden="true">↗</span>
        </div>
        <form asp-action="Create" method="post" enctype="multipart/form-data" id="messageForm" data-loading-form>
            @Html.AntiForgeryToken()
            <div asp-validation-summary="All" class="validation-summary" role="alert"></div>
            <div class="field">
                <label asp-for="SenderName">Your name <span>Required</span>
                </label>
                <input asp-for="SenderName" placeholder="How should we remember you?" autocomplete="name" minlength="2" maxlength="150" required aria-describedby="nameError" />
                <span asp-validation-for="SenderName" id="nameError" class="field-error"></span>
            </div>
            <div class="field">
                <label asp-for="Content">Your message <span>Required</span>
                </label>
                <textarea asp-for="Content" rows="6" placeholder="Dear Mohammed…" minlength="10" maxlength="2000" required data-character-count aria-describedby="messageHint contentError"></textarea>
                <div class="field-meta" id="messageHint">
                    <span>A little heart goes a long way. At least 10 characters.</span>
                    <span>
                        <span data-count-output>0</span> / 2,000</span>
                </div>
                <span asp-validation-for="Content" id="contentError" class="field-error"></span>
            </div>
            <fieldset class="field reaction-field">
                <legend>Say it with a feeling</legend>
                <div class="reaction-picker">
                    @foreach (var reaction in reactions) {
                    <label class="reaction-option">
                        <input type="radio" asp-for="ReactionType" id="reaction-@reaction.Item2.Replace(" ", "-")" value="@reaction.Item1" />
                        <span title="@reaction.Item2">
                            <span aria-hidden="true">@reaction.Item1</span>
                            <span class="sr-only">@reaction.Item2</span>
                        </span>
                    </label>
                    }
                </div>
            </fieldset>
            <div class="field">
                <label asp-for="Image">A photograph to go with it <span>Optional</span>
                </label>
                <div class="upload-zone" data-upload>
                    <input asp-for="Image" type="file" accept=".jpg,.jpeg,.png,.gif,.webp" aria-describedby="uploadHint imageError" />
                    <div class="upload-prompt">
                        <span class="upload-icon" aria-hidden="true">↥</span>
                        <strong>Drop a memory here, or browse</strong>
                        <small id="uploadHint">JPG, PNG, GIF or WEBP · One photograph</small>
                    </div>
                    <div class="upload-preview" hidden>
                        <img alt="Selected photo preview" />
                        <span class="upload-filename"></span>
                    </div>
                    <button class="upload-remove" type="button" hidden aria-label="Remove selected photo">✕</button>
                </div>
                <span asp-validation-for="Image" id="imageError" class="field-error"></span>
                <span class="field-error" data-upload-error role="alert"></span>
            </div>
            <div class="form-actions">
                <a class="back-link" asp-controller="Messages" asp-action="Index">Cancel</a>
                <button class="button button-gold" type="submit" data-loading-label="Sending your words…">Send your message <span aria-hidden="true">↗</span>
                </button>
            </div>
        </form>
    </div>
</section>
@section Scripts {
<partial name="_ValidationScriptsPartial" />
}
