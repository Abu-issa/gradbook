@model MessageWallViewModel
@{ ViewData["Title"] = "The message wall"; }
<section class="page-intro shell">
    <div class="intro-label">
        <span class="eyebrow">THE MESSAGE WALL</span>
        <span class="edition-mark">VOL. 2026</span>
    </div>
    <div class="intro-grid">
        <h1>So many voices.<br />
            <em>One beautiful chapter.</em>
        </h1>
        <div>
            <p>Congratulations, little memories, and words that mean the world. A collection made by you.</p>
            <a class="button button-gold" asp-controller="Messages" asp-action="Create">Add your words <span aria-hidden="true">↗</span>
            </a>
        </div>
    </div>
</section>
<section class="wall-section shell">
    <div class="collection-toolbar">
        <span class="live-status" id="liveStatus" role="status">
            <span class="status-dot"></span>
            <span id="connectionLabel">Connecting to the wall…</span>
        </span>
        <span class="eyebrow">
            <span id="messageCount">@Model.Messages.Count()</span> MESSAGES & COUNTING</span>
    </div>
    <div class="empty-state" id="wallEmpty" hidden="@Model.Messages.Any()">
        <span class="empty-mark" aria-hidden="true">“</span>
        <h2>The first words<br />
            <em>could be yours.</em>
        </h2>
        <p>A new page, waiting for a little kindness.</p>
        <a class="button button-gold" asp-controller="Messages" asp-action="Create">Write the first message ↗</a>
    </div>
    <div class="notes-grid wall-grid" id="messageWall">
        @foreach (var message in Model.Messages) {
        <partial name="_MessageCard" model="message" />
        }
    </div>
</section>
@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@8.0.0/dist/browser/signalr.min.js" defer>
</script>
<script src="~/js/message-wall.js" asp-append-version="true" defer>
</script>
}
