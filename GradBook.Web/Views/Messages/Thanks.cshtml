@{ ViewData["Title"] = "Your words are here"; }
<section class="thanks-page shell">
    <div class="thanks-seal" aria-hidden="true">✓</div>
    <span class="eyebrow">SIGNED, SENT & APPRECIATED</span>
    <h1>A few words.<br />
        <em>A lasting feeling.</em>
    </h1>
    <p>Your message has been received. After a little review,<br class="desktop-break" /> it will become part of Mohammed’s graduation story.</p>
    <div class="thanks-actions">
        <a class="button button-gold" asp-controller="Messages" asp-action="Index">Back to the message wall ↗</a>
        <a class="text-link" asp-controller="Home" asp-action="Index">Explore the story</a>
    </div>
    <div class="thanks-share">
        <span class="eyebrow">GOOD MOMENTS ARE BETTER SHARED</span>
        <div>
            <a class="text-link" href="https://wa.me/" data-whatsapp target="_blank" rel="noopener noreferrer">Share on WhatsApp ↗</a>
            <button class="text-link" data-copy-link type="button">Copy site link ↗</button>
        </div>
    </div>
</section>
