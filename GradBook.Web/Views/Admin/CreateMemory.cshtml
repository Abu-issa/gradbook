@model CreateMemoryViewModel
@{
    ViewData["Title"] = "Add Memory";
    Layout = "_AdminLayout";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="admin-card">
            <form asp-action="CreateMemory" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label asp-for="Title" class="form-label">Title *</label>
                    <input asp-for="Title" class="form-control" placeholder="e.g., Graduation Ceremony">
                    <span asp-validation-for="Title" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label">Description</label>
                    <textarea asp-for="Description" class="form-control" rows="3"
                              placeholder="Brief description of this memory..."></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Image" class="form-label">Photo</label>
                    <input asp-for="Image" type="file" accept="image/*" class="form-control" onchange="previewImg(this)">
                    <img id="imgPrev" src="" alt="" class="mt-2 rounded" style="max-height:200px;display:none">
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-gold">
                        <i class="fas fa-save me-2"></i> Save Memory
                    </button>
                    <a asp-action="Memories" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function previewImg(input) {
            const img = document.getElementById('imgPrev');
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = e => { img.src = e.target.result; img.style.display = 'block'; };
                reader.readAsDataURL(input.files[0]);
            }
        }
    </script>
}
