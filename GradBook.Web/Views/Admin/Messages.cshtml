@model IEnumerable<GradBook.Domain.Entities.Message>
@{
    ViewData["Title"] = "Manage Messages";
    Layout = "_AdminLayout";
}

<div class="admin-card">
    <div class="admin-card-header mb-3">
        <h5><i class="fas fa-envelope me-2 text-gold"></i> All Messages (@Model.Count())</h5>
        <div class="d-flex gap-2">
            <button class="btn btn-sm btn-outline-secondary" onclick="filterMessages('all')">All</button>
            <button class="btn btn-sm btn-outline-warning" onclick="filterMessages('pending')">Pending</button>
            <button class="btn btn-sm btn-outline-success" onclick="filterMessages('approved')">Approved</button>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="empty-admin text-center py-5">
            <i class="fas fa-inbox fa-3x text-muted mb-3"></i>
            <p>No messages yet.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table admin-table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Sender</th>
                        <th>Message</th>
                        <th>Reaction</th>
                        <th>Date</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var msg in Model)
                    {
                        <tr class="msg-row @(msg.IsApproved ? "approved" : "pending")">
                            <td>@msg.Id</td>
                            <td><strong>@msg.SenderName</strong></td>
                            <td>
                                <span title="@msg.Content">@(msg.Content.Length > 80 ? msg.Content[..80] + "…" : msg.Content)</span>
                                @if (!string.IsNullOrEmpty(msg.ImageUrl))
                                {
                                    <img src="@msg.ImageUrl" class="msg-thumb ms-2" alt="">
                                }
                            </td>
                            <td class="text-center">@msg.ReactionType</td>
                            <td>@msg.CreatedAt.ToString("MMM dd, yyyy")</td>
                            <td>
                                @if (msg.IsApproved)
                                {
                                    <span class="badge bg-success">Approved</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">Pending</span>
                                }
                            </td>
                            <td>
                                @if (!msg.IsApproved)
                                {
                                    <form asp-action="ApproveMessage" method="post" class="d-inline">
                                        <input type="hidden" name="id" value="@msg.Id">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-success" title="Approve">
                                            <i class="fas fa-check"></i>
                                        </button>
                                    </form>
                                }
                                <form asp-action="DeleteMessage" method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@msg.Id">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-danger" title="Delete"
                                            onclick="return confirm('Are you sure you want to delete this message?')">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@section Scripts {
    <script>
        function filterMessages(status) {
            document.querySelectorAll('.msg-row').forEach(row => {
                if (status === 'all') row.style.display = '';
                else if (status === 'approved') row.style.display = row.classList.contains('approved') ? '' : 'none';
                else if (status === 'pending') row.style.display = row.classList.contains('pending') ? '' : 'none';
            });
        }
    </script>
}
