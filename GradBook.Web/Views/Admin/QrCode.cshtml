@{
    ViewData["Title"] = "QR Code";
    Layout = "_AdminLayout";
}

<div class="row justify-content-center">
    <div class="col-md-6 text-center">
        <div class="admin-card p-4">
            <h5 class="mb-3"><i class="fas fa-qrcode me-2 text-gold"></i> Graduation QR Code</h5>
            <p class="text-muted mb-4">
                Print this QR code on graduation tables so guests can scan and leave messages instantly.
            </p>
            <div class="qr-container">
                <div id="qrcode" class="mx-auto" style="width:220px;height:220px;background:#fff;display:flex;align-items:center;justify-content:center;border:3px solid #C9A84C;border-radius:12px;">
                    <div class="text-center p-3">
                        <div style="font-size:64px">🔳</div>
                        <p class="text-muted small mt-2">QR Code renders here<br>with your site URL</p>
                    </div>
                </div>
            </div>
            <div class="mt-4">
                <p class="text-muted small">Current URL: <strong id="siteUrl"></strong></p>
                <button onclick="copyLink()" class="btn btn-gold mt-2">
                    <i class="fas fa-copy me-2"></i> Copy Site Link
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/qrcode@1.5.3/build/qrcode.min.js"></script>
    <script>
        const url = window.location.origin;
        document.getElementById('siteUrl').textContent = url;
        document.getElementById('qrcode').innerHTML = '';
        QRCode.toCanvas(document.createElement('canvas'), url, { width: 220, margin: 1, color: { dark: '#1a1a1a', light: '#ffffff' } }, function(err, canvas) {
            if (!err) document.getElementById('qrcode').appendChild(canvas);
        });
        function copyLink() {
            navigator.clipboard.writeText(url).then(() => alert('Link copied!'));
        }
    </script>
}
