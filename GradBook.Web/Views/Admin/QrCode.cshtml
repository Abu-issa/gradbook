@{ ViewData["Title"] = "Share & QR code"; Layout = "_AdminLayout"; }
<div class="admin-heading">
    <div>
        <span class="eyebrow">AN OPEN INVITATION</span>
        <h1>Bring them <em>into the story.</em>
        </h1>
        <p>On the table. In an invitation. One scan brings everyone here.</p>
    </div>
</div>
<div class="qr-layout">
    <section class="qr-print-card" id="qrPrintCard">
        <span class="eyebrow">THE GRADUATION OF</span>
        <h2>Mohammed<br />
            <em>Abu-Issa.</em>
        </h2>
        <div id="qrcode" class="qr-code" role="img" aria-label="QR code linking to the graduation website">
            <span id="qrStatus" role="status">Preparing your invitation…</span>
        </div>
        <p>Scan. Leave a little love.<br />Become part of the story.</p>
        <span class="eyebrow">CLASS OF 2026 · GRADBOOK</span>
    </section>
    <aside class="qr-options">
        <span class="eyebrow">A CHAPTER TO SHARE</span>
        <h2>One little square.<br />
            <em>So many connections.</em>
        </h2>
        <p>This code opens the public homepage, where guests can explore the memories and leave a message.</p>
        <label class="field-label" for="siteUrl">Your site address</label>
        <input id="siteUrl" class="share-url" readonly />
        <div class="qr-actions">
            <button class="button button-gold" data-copy-link type="button">Copy site link ↗</button>
            <button class="button button-quiet" type="button" id="printQr" disabled>Print invitation ↗</button>
        </div>
        <p class="muted small-copy">Print from the deployed website so guests receive its public address.</p>
    </aside>
</div>
@section Scripts {
<script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js" defer>
</script>
<script src="~/js/qr.js" asp-append-version="true" defer>
</script>
}
