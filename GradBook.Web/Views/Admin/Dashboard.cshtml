@model AdminDashboardViewModel
@{ ViewData["Title"] = "Overview"; Layout = "_AdminLayout"; }
<div class="admin-heading">
    <div>
        <span class="eyebrow">A LITTLE CARE FOR EVERY MEMORY</span>
        <h1>Your chapter,<br />
            <em>beautifully kept.</em>
        </h1>
        <p>Welcome back. Here’s what’s happening in the book.</p>
    </div>
    <a class="button button-gold" asp-action="CreateMemory">Add a memory ↗</a>
</div>
<div class="metric-grid">
    <div class="metric">
        <span>Total messages</span>
        <strong>@Model.TotalMessages.ToString("D2")</strong>
        <small>Words from your people</small>
        <span class="metric-icon" aria-hidden="true">↗</span>
    </div>
    <div class="metric metric-accent">
        <span>Awaiting your review</span>
        <strong>@Model.PendingMessages.ToString("D2")</strong>
        <a asp-action="Messages">Open message desk →</a>
    </div>
    <div class="metric">
        <span>Visits to the story</span>
        <strong>@Model.TotalVisitors.ToString("D2")</strong>
        <small>@Model.TodayVisitors today</small>
    </div>
    <div class="metric">
        <span>Memories preserved</span>
        <strong>@Model.TotalMemories.ToString("D2")</strong>
        <a asp-action="Memories">Explore the journal →</a>
    </div>
</div>
<div class="dashboard-grid">
    <section class="workspace-panel">
        <div class="panel-heading">
            <div>
                <span class="eyebrow">THE INBOX</span>
                <h2>A few words waiting.</h2>
            </div>
            <a class="text-link" asp-action="Messages">View all ↗</a>
        </div>
        @if (!Model.PendingMessagesList.Any()) {
        <div class="admin-empty">
            <span aria-hidden="true">✓</span>
            <h3>All caught up.</h3>
            <p>Every message has found its place.</p>
        </div>
        }
        else {
        <div class="pending-list">
            @foreach (var msg in Model.PendingMessagesList.Take(5)) {
            <article class="pending-entry">
                <div class="pending-meta">
                    <strong dir="auto">@msg.SenderName</strong>
                    <time>@msg.CreatedAt.ToString("MMM dd, yyyy")</time>
                    <span>@msg.ReactionType</span>
                </div>
                <details class="message-details">
                    <summary>@(msg.Content.Length > 110 ? msg.Content[..110] + "…" : msg.Content)<span>Read full message ↗</span>
                    </summary>
                    <p dir="auto">@msg.Content</p>
                    @if (!string.IsNullOrEmpty(msg.ImageUrl)) {
                    <button type="button" class="review-image image-trigger" data-image="@msg.ImageUrl" data-title="Photo from @msg.SenderName">
                        <img src="@msg.ImageUrl" alt="Photo from @msg.SenderName" />View photograph ↗</button>
                    }
                </details>
                <partial name="_ModerationActions" model="msg" />
            </article>
            }
        </div>
        }
    </section>
    <aside class="desk-aside">
        <div class="desk-note">
            <span class="eyebrow">FROM THE EDITOR’S DESK</span>
            <span class="desk-star" aria-hidden="true">🎓</span>
            <h2>Good memories<br />deserve <em>a home.</em>
            </h2>
            <p>Add the photographs that tell your story. The big days and the little moments alike.</p>
            <a class="text-link" asp-action="CreateMemory">Add to the journal ↗</a>
        </div>
        <a class="share-panel" asp-action="QrCode">
            <span aria-hidden="true">⊞</span>
            <div>
                <strong>Bring everyone into the story</strong>
                <p>Your link & graduation QR code</p>
            </div>
            <span aria-hidden="true">↗</span>
        </a>
    </aside>
</div>
