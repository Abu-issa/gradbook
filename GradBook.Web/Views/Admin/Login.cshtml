@model AdminLoginViewModel
@{ ViewData["Title"] = "The editor’s desk"; Layout = null; }
<!DOCTYPE html>
<html lang="en" data-theme="dark">
    <head>
        <partial name="_Head" />
        <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    </head>
    <body class="login-page">
        <div class="login-art">
            <img src="~/images/graduate.jpg" alt="Portrait of Mohammed Abu-Issa" />
            <a class="wordmark" asp-controller="Home" asp-action="Index">
                <span class="brand-symbol" aria-hidden="true">g.</span> gradbook.</a>
            <div>
                <span class="eyebrow">THE GRADUATION EDITION / 2026</span>
                <h1>Every story<br />needs <em>a keeper.</em>
                </h1>
            </div>
        </div>
        <main class="login-main">
            <a class="back-link" asp-controller="Home" asp-action="Index">← Back to the story</a>
            <div class="login-form">
                <span class="eyebrow">THE EDITOR’S DESK</span>
                <h2>Welcome <em>back.</em>
                </h2>
                <p>A little care for the moments that matter.</p>
                <form asp-action="Login" method="post" data-loading-form>@Html.AntiForgeryToken()<div asp-validation-summary="All" class="validation-summary" role="alert"></div>
                    <div class="field">
                        <label asp-for="Username">Username</label>
                        <input asp-for="Username" autocomplete="username" required placeholder="Your username" />
                        <span asp-validation-for="Username" class="field-error"></span>
                    </div>
                    <div class="field">
                        <label asp-for="Password">Password</label>
                        <div class="password-field">
                            <input asp-for="Password" type="password" autocomplete="current-password" required placeholder="Your password" />
                            <button type="button" data-password-toggle aria-label="Show password">Show</button>
                        </div>
                        <span asp-validation-for="Password" class="field-error"></span>
                    </div>
                    <button type="submit" class="button button-gold button-full" data-loading-label="Signing in…">Enter your workspace ↗</button>
                </form>
                <span class="login-footnote">GRADBOOK · A PERSONAL ARCHIVE</span>
            </div>
        </main>
        <script src="~/js/site.js" asp-append-version="true" defer>
        </script>
        <partial name="_ValidationScriptsPartial" />
    </body>
</html>
