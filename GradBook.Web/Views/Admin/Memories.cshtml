@model IEnumerable<Memory>
@{ ViewData["Title"] = "Photo journal"; Layout = "_AdminLayout"; }
<div class="admin-heading">
    <div>
        <span class="eyebrow">YOUR VISUAL ARCHIVE</span>
        <h1>Keep the <em>feeling.</em>
        </h1>
        <p>@Model.Count() memories, and room for so many more.</p>
    </div>
    <a class="button button-gold" asp-action="CreateMemory">Add a memory ↗</a>
</div>
@if (!Model.Any()) {
<div class="workspace-panel admin-empty">
    <span aria-hidden="true">◈</span>
    <h2>Your journal starts here.</h2>
    <p>A photograph. A few words. A moment to keep.</p>
    <a class="button button-gold" asp-action="CreateMemory">Add the first memory ↗</a>
</div>
}
else {
<div class="admin-memory-grid">
    @foreach (var memory in Model) {
    <article class="admin-memory">
        <partial name="_MemoryCard" model="memory" />
        <div class="memory-management">
            <span>MEMORY #@memory.Id</span>
            <form asp-action="DeleteMemory" method="post" data-delete-form data-delete-title="Delete this memory?">
                <input type="hidden" name="id" value="@memory.Id" />@Html.AntiForgeryToken()<button class="button button-delete" type="submit" aria-label="Delete @memory.Title">Delete memory</button>
            </form>
        </div>
    </article>
    }
</div>
}
