@model IEnumerable<GradBook.Domain.Entities.Memory>
@{
    ViewData["Title"] = "Manage Memories";
    Layout = "_AdminLayout";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h5 class="mb-0">@Model.Count() memories in gallery</h5>
    <a asp-action="CreateMemory" class="btn btn-gold">
        <i class="fas fa-plus me-2"></i> Add Memory
    </a>
</div>

@if (!Model.Any())
{
    <div class="admin-card text-center py-5">
        <i class="fas fa-images fa-3x text-muted mb-3"></i>
        <p>No memories added yet.</p>
        <a asp-action="CreateMemory" class="btn btn-gold mt-2">Add First Memory</a>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var memory in Model)
        {
            <div class="col-md-6 col-xl-4">
                <div class="admin-card memory-admin-card">
                    @if (!string.IsNullOrEmpty(memory.ImageUrl))
                    {
                        <img src="@memory.ImageUrl" alt="@memory.Title" class="memory-admin-img">
                    }
                    else
                    {
                        <div class="memory-admin-placeholder">
                            <i class="fas fa-image fa-2x text-muted"></i>
                        </div>
                    }
                    <div class="p-3">
                        <h6 class="fw-bold">@memory.Title</h6>
                        @if (!string.IsNullOrEmpty(memory.Description))
                        {
                            <p class="text-muted small mb-2">@memory.Description</p>
                        }
                        <div class="d-flex justify-content-between align-items-center">
                            <small class="text-muted">@memory.CreatedAt.ToString("MMM dd, yyyy")</small>
                            <form asp-action="DeleteMemory" method="post">
                                <input type="hidden" name="id" value="@memory.Id">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger"
                                        onclick="return confirm('Delete this memory?')">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
