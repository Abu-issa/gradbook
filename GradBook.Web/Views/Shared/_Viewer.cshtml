<dialog class="image-viewer" id="imageViewer" aria-labelledby="viewerTitle">
    <div class="viewer-toolbar">
        <span class="eyebrow">A MOMENT, PRESERVED</span>
        <button class="icon-button" type="button" data-close-viewer aria-label="Close image viewer">✕</button>
    </div>
    <div class="viewer-stage">
        <img id="viewerImage" alt="" />
    </div>
    <div class="viewer-caption">
        <h2 id="viewerTitle"></h2>
        <p id="viewerDescription"></p>
    </div>
</dialog>
