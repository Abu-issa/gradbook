@{ var controller = ViewContext.RouteData.Values["controller"]?.ToString(); }
<!DOCTYPE html>
<html lang="en" data-theme="dark">
    <head>
        <partial name="_Head" />
        @await RenderSectionAsync("Styles", required: false)
    </head>
    <body class="public-site">
        <a class="skip-link" href="#main">Skip to content</a>
        <header class="site-header">
            <div class="shell header-inner">
                <a class="wordmark" asp-controller="Home" asp-action="Index" aria-label="GradBook home">
                    <span class="brand-symbol" aria-hidden="true">g.</span> gradbook<span class="brand-period">.</span>
                </a>
                <span class="header-edition">A PERSONAL ARCHIVE <span>—</span> 2026</span>
                <button class="icon-button mobile-menu-toggle" aria-label="Open navigation" aria-expanded="false" aria-controls="publicNav" data-menu-toggle>☰</button>
                <nav class="public-nav" id="publicNav" aria-label="Main navigation">
                    <a asp-controller="Home" asp-action="Index" aria-current="@(controller == "Home" ? "page" : null)">The story</a>
                    <a asp-controller="Messages" asp-action="Index" aria-current="@(controller == "Messages" ? "page" : null)">The messages</a>
                    <a asp-controller="Memories" asp-action="Index" aria-current="@(controller == "Memories" ? "page" : null)">The memories</a>
                    <a class="nav-write" asp-controller="Messages" asp-action="Create">Leave a note <span aria-hidden="true">↗</span>
                    </a>
                </nav>
                <button class="icon-button theme-toggle" data-theme-toggle aria-label="Switch color theme" title="Switch color theme">
                    <span aria-hidden="true">◐</span>
                </button>
            </div>
        </header>
        <main id="main" tabindex="-1">@RenderBody()</main>
        <footer class="site-footer">
            <div class="shell">
                <div class="footer-top">
                    <a class="wordmark" asp-controller="Home" asp-action="Index">
                        <span class="brand-symbol" aria-hidden="true">g.</span> gradbook.</a>
                    <p>A moment in time.<br />
                        <em>A place to keep it.</em>
                    </p>
                    <a class="text-link" asp-controller="Messages" asp-action="Create">Be part of the story <span aria-hidden="true">↗</span>
                    </a>
                </div>
                <div class="footer-bottom">
                    <span>© 2026 · Crafted by Eng. Mohammed Abu-Issa</span>
                    <div class="footer-links">
                        <a href="https://www.instagram.com/mo_ahmad25" target="_blank" rel="noopener noreferrer">Instagram ↗</a>
                        <a href="https://www.facebook.com/share/14iB4qwMZu6/" target="_blank" rel="noopener noreferrer">Facebook ↗</a>
                        <button type="button" data-copy-link>Copy link</button>
                        <a asp-controller="Admin" asp-action="Login">Admin</a>
                    </div>
                </div>
            </div>
        </footer>
        <partial name="_Viewer" />
        <div class="toast-region" id="toastContainer" role="status" aria-live="polite"></div>
        <script src="~/js/site.js" asp-append-version="true" defer>
        </script>
        @await RenderSectionAsync("Scripts", required: false)
    </body>
</html>
