<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="GradBook - A Digital Graduation Memory Book for Eng. Mohammed Abu-Issa" />
    <title>@ViewData["Title"] - GradBook | Eng. Mohammed Abu-Issa</title>

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;0,700;1,300;1,400&family=Jost:wght@300;400;500;600&family=Cinzel:wght@400;600;700&display=swap" rel="stylesheet">

    <!-- Bootstrap 5 -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <!-- AOS -->
    <link rel="stylesheet" href="https://unpkg.com/aos@2.3.4/dist/aos.css">

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @RenderSection("Styles", required: false)
</head>
<body>

<!-- Particle Canvas -->
<canvas id="particleCanvas"></canvas>

<!-- Navigation -->
<nav class="navbar navbar-expand-lg fixed-top" id="mainNav">
    <div class="container">
        <a class="navbar-brand" asp-controller="Home" asp-action="Index">
            <span class="brand-icon">🎓</span>
            <span class="brand-text">GradBook</span>
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
            <i class="fas fa-bars text-gold"></i>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav ms-auto align-items-center">
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Home" asp-action="Index">
                        <i class="fas fa-home me-1"></i> Home
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Messages" asp-action="Index">
                        <i class="fas fa-comments me-1"></i> Messages
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Memories" asp-action="Index">
                        <i class="fas fa-images me-1"></i> Memories
                    </a>
                </li>
                <li class="nav-item ms-2">
                    <a class="btn btn-gold btn-sm" asp-controller="Messages" asp-action="Create">
                        <i class="fas fa-pen-nib me-1"></i> Write Message
                    </a>
                </li>
                <li class="nav-item ms-2">
                    <button class="btn btn-ghost btn-sm" id="themeToggle" title="Toggle Theme">
                        <i class="fas fa-sun" id="themeIcon"></i>
                    </button>
                </li>
            </ul>
        </div>
    </div>
</nav>

<!-- Main Content -->
<main>
    @RenderBody()
</main>

<!-- Footer -->
<footer class="footer">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-md-4 text-center text-md-start">
                <div class="footer-brand">
                    <span class="text-gold">🎓</span> GradBook
                </div>
                <p class="footer-tagline">A lifetime of memories, one page at a time.</p>
            </div>
            <div class="col-md-4 text-center my-3 my-md-0">
                <div class="footer-graduate-name">Eng. Mohammed Abu-Issa</div>
                <div class="footer-year">Class of 2026</div>
            </div>
            <div class="col-md-4 text-center text-md-end">
                <div class="footer-social">
                        <a href="https://www.instagram.com/mo_ahmad25?igsh=MXQ0MHphNjBjdmY2Nw%3D%3D&utm_source=qr" target="_blank" class="social-btn instagram">
                            <i class="fab fa-instagram"></i>
                    </a>
                        <a href="https://www.facebook.com/share/14iB4qwMZu6/?mibextid=wwXIfr" target="_blank" class="social-btn facebook">
                        <i class="fab fa-facebook-f"></i>
                    </a>
                    <a href="#" onclick="copyLink()" class="social-btn copy">
                        <i class="fas fa-link"></i>
                    </a>
                </div>
                <div class="mt-2 small text-muted">
                    <a asp-controller="Admin" asp-action="Login" class="text-muted">Admin</a>
                </div>
            </div>
        </div>
        <hr class="footer-divider">
            <p class="text-center footer-copy">
                &copy; 2025 GradBook — Designed & Developed with
                <span class="text-gold">♥</span> by Eng. Mohammed Abu-Issa
            </p>
    </div>
</footer>

<!-- Toast Container -->
<div class="toast-container position-fixed bottom-0 end-0 p-3" id="toastContainer"></div>

<!-- Scripts -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://unpkg.com/aos@2.3.4/dist/aos.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@8.0.0/dist/browser/signalr.min.js"></script>
<script src="~/js/particles.js" asp-append-version="true"></script>
<script src="~/js/site.js" asp-append-version="true"></script>

@if (TempData["Success"] != null)
{
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            Swal.fire({
                icon: 'success',
                title: 'Success!',
                text: '@TempData["Success"]',
                confirmButtonColor: '#C9A84C',
                background: '#1a1a1a',
                color: '#f5f0e8',
                iconColor: '#C9A84C'
            });
        });
    </script>
}

@RenderSection("Scripts", required: false)
</body>
</html>
