@{ var action = ViewContext.RouteData.Values["action"]?.ToString(); }
<!DOCTYPE html>
<html lang="en" data-theme="dark">
    <head>
        <partial name="_Head" />
        <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    </head>
    <body class="admin-body">
        <a class="skip-link" href="#main">Skip to content</a>
        <button class="sidebar-backdrop" data-admin-close aria-label="Close navigation" hidden>
        </button>
        <aside class="admin-sidebar" id="adminSidebar" aria-label="Workspace sidebar">
            <a class="wordmark" asp-controller="Admin" asp-action="Dashboard">
                <span class="brand-symbol" aria-hidden="true">g.</span> gradbook.</a>
            <div class="workspace-label">
                <span class="status-dot"></span> THE EDITOR’S DESK</div>
            <nav class="sidebar-nav" aria-label="Workspace navigation">
                <span class="nav-group-label">YOUR WORKSPACE</span>
                <a asp-controller="Admin" asp-action="Dashboard" aria-current="@(action == "Dashboard" ? "page" : null)">
                    <span aria-hidden="true">◫</span> Overview</a>
                <a asp-controller="Admin" asp-action="Messages" aria-current="@(action == "Messages" ? "page" : null)">
                    <span aria-hidden="true">☷</span> Messages</a>
                <a asp-controller="Admin" asp-action="Memories" aria-current="@(action == "Memories" || action == "CreateMemory" ? "page" : null)">
                    <span aria-hidden="true">▧</span> Photo journal</a>
                <a asp-controller="Admin" asp-action="QrCode" aria-current="@(action == "QrCode" ? "page" : null)">
                    <span aria-hidden="true">⊞</span> Share & QR code</a>
            </nav>
            <div class="sidebar-bottom">
                <div class="sidebar-edition">
                    <span>THE GRADUATION EDITION</span>
                    <strong>Class of 2026</strong>
                    <p>A chapter worth looking after.</p>
                </div>
                <a class="text-link" asp-controller="Home" asp-action="Index" target="_blank" rel="noopener">View public site ↗</a>
                <a class="logout-link" asp-controller="Admin" asp-action="Logout">Sign out <span aria-hidden="true">↗</span>
                </a>
            </div>
        </aside>
        <div class="admin-content">
            <header class="admin-topbar">
                <div>
                    <button class="icon-button admin-menu-toggle" data-admin-toggle aria-expanded="false" aria-controls="adminSidebar" aria-label="Open workspace navigation">☰</button>
                    <span class="muted">Workspace</span>
                    <span class="topbar-slash">/</span>
                    <span>@ViewData["Title"]</span>
                </div>
                <div>
                    <button class="icon-button" data-theme-toggle aria-label="Switch color theme">◐</button>
                    <span class="admin-avatar" aria-label="Administrator">MA</span>
                </div>
            </header>
            <main class="admin-main" id="main" tabindex="-1">
                @if (TempData["Success"] != null) {
                <div class="notice notice-success" role="status">
                    <span aria-hidden="true">✓</span>@TempData["Success"]<button class="icon-button" data-dismiss-notice aria-label="Dismiss notification">✕</button>
                </div>
                }
                @RenderBody()
            </main>
            <footer class="admin-footer">
                <span>GradBook / The editor’s desk</span>
                <span>Made for the moments that matter.</span>
            </footer>
        </div>
        <partial name="_Viewer" />
        <dialog class="confirm-dialog" id="confirmDialog" aria-labelledby="confirmTitle">
            <span class="eyebrow">A MOMENT TO DOUBLE-CHECK</span>
            <h2 id="confirmTitle">Delete this item?</h2>
            <p>This removes it permanently. This action cannot be undone.</p>
            <div class="form-actions">
                <button class="button button-quiet" data-cancel-delete type="button">Keep it</button>
                <button class="button button-danger" data-confirm-delete type="button">Delete permanently</button>
            </div>
        </dialog>
        <div class="toast-region" id="toastContainer" role="status" aria-live="polite"></div>
        <script src="~/js/site.js" asp-append-version="true" defer>
        </script>
        <script src="~/js/admin.js" asp-append-version="true" defer>
        </script>
        @await RenderSectionAsync("Scripts", required: false)
    </body>
</html>
