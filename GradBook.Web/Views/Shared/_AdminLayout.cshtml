<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin — @ViewData["Title"] | GradBook</title>
    <link href="https://fonts.googleapis.com/css2?family=Jost:wght@300;400;500;600&family=Cinzel:wght@600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
</head>
<body class="admin-body">
    <div class="admin-sidebar">
        <div class="sidebar-brand">
            <span>🎓</span> GradBook
            <small>Admin Panel</small>
        </div>
        <nav class="sidebar-nav">
            <a asp-controller="Admin" asp-action="Dashboard" class="sidebar-link">
                <i class="fas fa-tachometer-alt"></i> Dashboard
            </a>
            <a asp-controller="Admin" asp-action="Messages" class="sidebar-link">
                <i class="fas fa-envelope"></i> Messages
            </a>
            <a asp-controller="Admin" asp-action="Memories" class="sidebar-link">
                <i class="fas fa-images"></i> Memories
            </a>
            <a asp-controller="Admin" asp-action="QrCode" class="sidebar-link">
                <i class="fas fa-qrcode"></i> QR Code
            </a>
            <hr class="sidebar-divider">
            <a asp-controller="Home" asp-action="Index" class="sidebar-link" target="_blank">
                <i class="fas fa-external-link-alt"></i> View Site
            </a>
            <a asp-controller="Admin" asp-action="Logout" class="sidebar-link text-danger">
                <i class="fas fa-sign-out-alt"></i> Logout
            </a>
        </nav>
    </div>
    <div class="admin-content">
        <div class="admin-topbar">
            <h1 class="admin-page-title">@ViewData["Title"]</h1>
            <div class="admin-user">
                <i class="fas fa-user-shield me-2"></i> Administrator
            </div>
        </div>
        <div class="admin-main p-4">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show">
                    <i class="fas fa-check-circle me-2"></i> @TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @RenderBody()
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
