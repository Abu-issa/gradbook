@model MemoriesViewModel
@{ ViewData["Title"] = "The memories"; }
<section class="page-intro shell">
    <div class="intro-label">
        <span class="eyebrow">THE PHOTO JOURNAL</span>
        <span class="edition-mark">VOL. 2026</span>
    </div>
    <div class="intro-grid">
        <h1>A moment passes.<br />
            <em>A memory stays.</em>
        </h1>
        <div>
            <p>The big milestones. The little in-between moments. A few pieces of a journey worth remembering.</p>
            <span class="eyebrow">@Model.Memories.Count().ToString("D2") MEMORIES IN THE ARCHIVE</span>
        </div>
    </div>
</section>
<section class="shell gallery-section">
    @if (Model.Memories.Any()) {
    <div class="journal-grid">
        @foreach (var memory in Model.Memories) {
        <partial name="_MemoryCard" model="memory" />
        }
    </div>
    }
    else {
    <div class="empty-state">
        <span class="empty-mark" aria-hidden="true">◈</span>
        <h2>Good things<br />
            <em>are developing.</em>
        </h2>
        <p>The first photographs will find their home here soon.</p>
        <a class="text-link" asp-controller="Home" asp-action="Index">Back to the story ↗</a>
    </div>
    }
</section>
<partial name="_ClosingNote" />
