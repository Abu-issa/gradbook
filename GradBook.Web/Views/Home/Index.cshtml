@model HomeViewModel
@{ ViewData["Title"] = "A new chapter"; var graduationDate = Model.Graduate?.GraduationDate ?? new DateTime(2026, 7, 22); }
<section class="cinema-hero">
    <div class="hero-photo">
        <img src="~/images/graduate.jpg" alt="Portrait of Eng. Mohammed Abu-Issa" fetchpriority="high" width="2976" height="4464" />
    </div>
    <div class="hero-year" aria-hidden="true">20<br />26</div>
    <div class="shell hero-layout">
        <div class="hero-kicker">
            <span class="small-star" aria-hidden="true">🎓</span>
            <span>THE GRADUATION EDITION<br />
                <span class="muted">ONE JOURNEY. COUNTLESS MEMORIES.</span>
            </span>
        </div>
        <div class="hero-title-wrap">
            <p class="hero-prefix">Engineer. Dreamer. A new beginning.</p>
            <h1>Mohammed<br />
                <em>Abu-Issa.</em>
            </h1>
        </div>
        <div class="hero-bottom">
            <div class="hero-intro">
                <span class="eyebrow">@(Model.Graduate?.Title ?? "Bachelor of Engineering")</span>
                <p>Some chapters change everything.<br />This one belongs to all of us.</p>
                <a class="button button-gold" asp-controller="Messages" asp-action="Create">Leave your words <span aria-hidden="true">↗</span>
                </a>
            </div>
            <div class="hero-caption">
                <span class="caption-line"></span>
                <span>THE NEXT CHAPTER<br />
                    <strong>Class of @graduationDate.Year</strong>
                </span>
            </div>
        </div>
        <a class="hero-scroll" href="#chapter">
            <span>SCROLL TO EXPLORE</span>
            <span aria-hidden="true">↓</span>
        </a>
    </div>
</section>
<section class="milestone-strip" data-countdown="@graduationDate.ToString("yyyy-MM-dd")T00:00:00">
    <div class="shell milestone-inner">
        <span class="eyebrow">A MILESTONE WORTH REMEMBERING</span>
        <span class="milestone-date">@graduationDate.ToString("dd MMMM yyyy")</span>
        <span class="milestone-status" id="milestoneStatus">The beginning of everything <span aria-hidden="true">↗</span>
        </span>
        <div class="countdown-display" id="countdown" hidden aria-label="Time until graduation"></div>
    </div>
</section>
<section class="chapter-section section-space" id="chapter">
    <div class="shell chapter-grid">
        <div class="section-index reveal">
            <span>01 / THE CHAPTER</span>
            <span class="fine-line"></span>
        </div>
        <div class="chapter-copy reveal">
            <h2>A little pride.<br />A lot of heart.<br />
                <em>A whole new world.</em>
            </h2>
            <div class="chapter-detail">
                <p>@(Model.Graduate?.Bio ?? "A journey of dedication, perseverance, and passion. Today marks the beginning of a new chapter.")</p>
                <p class="muted">For everyone who was part of the journey — this is your place, too.</p>
            </div>
        </div>
        <div class="chapter-stats reveal">
            <div>
                <strong>@Model.TotalMessages.ToString("D2")</strong>
                <span>Messages received</span>
            </div>
            <div>
                <strong>@Model.TotalVisitors.ToString("D2")</strong>
                <span>Visits to this chapter</span>
            </div>
            <span class="stats-footnote">Every word. Every visit.<br />Part of the story.</span>
        </div>
    </div>
</section>
<section class="home-notes section-space">
    <div class="shell">
        <div class="section-heading reveal">
            <div>
                <span class="eyebrow">02 / THE PEOPLE BEHIND THE MOMENT</span>
                <h2>Good wishes.<br />
                    <em>Kept forever.</em>
                </h2>
            </div>
            <div class="section-aside">
                <p>From the people who made<br />the journey mean more.</p>
                <a class="text-link" asp-controller="Messages" asp-action="Index">Explore the message wall <span aria-hidden="true">↗</span>
                </a>
            </div>
        </div>
        @if (Model.RecentMessages.Any()) {
        <div class="notes-grid home-note-grid">
            @foreach (var message in Model.RecentMessages) {
            <partial name="_MessageCard" model="message" />
            }
        </div>
        } else {
        <div class="first-note reveal">
            <span class="large-quote" aria-hidden="true">“</span>
            <p>Every story starts<br />with a few <em>kind words.</em>
            </p>
            <a class="text-link" asp-controller="Messages" asp-action="Create">Write the very first note <span aria-hidden="true">↗</span>
            </a>
        </div>
        }
    </div>
</section>
<section class="home-gallery section-space">
    <div class="shell">
        <div class="section-heading reveal">
            <div>
                <span class="eyebrow">03 / THE MOMENTS IN BETWEEN</span>
                <h2>More than<br />
                    <em>photographs.</em>
                </h2>
            </div>
            <a class="text-link" asp-controller="Memories" asp-action="Index">Open the archive <span aria-hidden="true">↗</span>
            </a>
        </div>
        @if (Model.RecentMemories.Any()) {
        <div class="journal-grid home-journal">
            @foreach (var memory in Model.RecentMemories) {
            <partial name="_MemoryCard" model="memory" />
            }
        </div>
        }
        else {
        <div class="archive-preview reveal">
            <img src="~/images/graduate.jpg" alt="Mohammed, at the beginning of a new chapter" loading="lazy" />
            <div>
                <span class="eyebrow">THE ARCHIVE IS JUST BEGINNING</span>
                <p>The days pass.<br />
                    <em>The moments stay.</em>
                </p>
                <a class="text-link" asp-controller="Memories" asp-action="Index">Visit the gallery ↗</a>
            </div>
        </div>
        }
    </div>
</section>
<partial name="_ClosingNote" />
